# Go 读取进程环境变量，不会自动加载此文件；本机可复制后使用 shell 导出。
MYSQL_DSN='research:dev-research-password@tcp(127.0.0.1:13306)/research?charset=utf8mb4'
JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_URL=redis://127.0.0.1:16379/0
CACHE_PREFIX=arp

# V5 使用独立 Redis 队列；缓存 Redis 与队列不能混用淘汰策略。
QUEUE_REDIS_URL=redis://127.0.0.1:16380/0
QUEUE_PREFIX=arp
WORKER_CONCURRENCY=2
MAX_ACTIVE_TASKS_PER_USER=3
