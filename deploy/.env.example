# 服务器上线时替换为真实域名，不加路径。Caddy 自动申请和续期 HTTPS 证书。
# 例如：SITE_ADDRESS=agent.luananwei.me
# 默认值用于 Docker 本机预览，只提供 HTTP。
SITE_ADDRESS=http://localhost

# 同时允许执行的完整研究/普通问答请求总数，超过时返回 429。
MAX_CONCURRENT_RESEARCH=2

# 所有访客共享每分钟请求次数，0 表示关闭频率限制。
RATE_LIMIT_PER_MINUTE=20

# 启用 compose.data.yaml 时必填，建议分别用 openssl rand -hex 32 生成。
# 使用十六进制字符串，避免密码中的 URL/DSN 特殊字符。
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex
REDIS_PASSWORD=replace-with-another-random-hex
JWT_SECRET=replace-with-at-least-32-random-bytes
SEARCH_CACHE_TTL_SECONDS=900
