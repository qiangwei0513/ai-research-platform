# 复制为 agent-service/.env，填写已经验证可用的模型与搜索配置。
# 不要把真实 Key 填回本示例，也不要提交真实 .env。
OPENAI_API_KEY=replace-with-your-model-api-key
OPENAI_BASE_URL=https://your-model-provider.example/v1
TAVILY_API_KEY=replace-with-your-tavily-api-key
OPENAI_AGENTS_DISABLE_TRACING=1

# 本机可选搜索缓存，与根目录 compose.yaml 的端口一致。
# REDIS_URL=redis://127.0.0.1:16379/0
CACHE_PREFIX=arp
SEARCH_CACHE_TTL_SECONDS=900

# 单个 Python 进程的总执行槽、搜索并发、搜索实际请求（包含重试）预算。
AGENT_MAX_CONCURRENCY=4
SEARCH_MAX_CONCURRENCY=4
SEARCH_CALLS_PER_MINUTE=120
SEARCH_CALLS_PER_TASK=6
MODEL_MAX_OUTPUT_TOKENS=10000
RESEARCH_MODEL=deepseek-flash
# 可选 OpenAI tracing。需要独立 OpenAI key，并将上方 DISABLE_TRACING 改成 0。
ENABLE_OPENAI_TRACING=0
# OPENAI_TRACING_API_KEY=
